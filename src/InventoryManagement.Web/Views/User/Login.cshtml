@model InventoryManagement.Web.Models.User.LoginViewModel;
@{
    ViewData["Title"] = "Login";
}

@section Styles{
    <link rel="stylesheet" href="~/css/pages/login.css" />
    <link rel="stylesheet" href="~/css/validate-forms.css" />
}

<div class="container-signin">

    <form class="form-signin validate-forms" asp-controller="User" asp-action="Login" novalidate>
        <div class="container-fields">
            <h1 id="title-signin">Login</h1>

            <label class="lb-fields-signin" for="txt-user">Usuário:</label>
            <input class="fields-signin" id="txt-user" type="text" asp-for="Login" required/>

            <label class="lb-fields-signin" for="txt-password">Senha:</label>
            <input class="fields-signin" id="txt-password" type="text" asp-for="Password" required/>

            <button class="btn-signin" type="submit">Prosseguir</button>

            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        </div>
    </form>

</div>

@section Scripts {
    <script src="~/js/validate-forms.js"></script>
}