@model InventoryManagement.Web.Models.User.LoginViewModel;
@{
    ViewData["Title"] = "Login";
}

@section Styles{
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="container-signin">

    <form class="form-signin">
        <div class="container-fields">
            <h1 id="title-signin">Login</h1>

            <label class="lb-fields-signin" for="txt-user">Usuário:</label>
            <input class="fields-signin" id="txt-user" type="text" />

            <label class="lb-fields-signin" for="txt-password">Senha:</label>
            <input class="fields-signin" id="txt-password" type="text" />

            <button class="btn-signin" type="submit">Prosseguir</button>
        </div>
        
       
        
    </form>

</div>