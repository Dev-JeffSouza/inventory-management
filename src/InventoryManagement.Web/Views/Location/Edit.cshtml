@using InventoryManagement.Web.Models.Panel
@model InventoryManagement.Web.Models.Location.EditViewModel

@{
    ViewData["Title"] = "Locais";
    ViewData["Panel"] = Panel.Locais;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/edit-location .css" />
    <link rel="stylesheet" href="~/css/validate-forms.css" />
}

<div class="location-edit-container">
    <span id="title-register">Editar Local de Estoque</span>

    <form class="location-form validate-forms" novalidate asp-controller="Location" asp-action="Edit">

        <div class="form-group">
            <label for="codlocal">Código</label>
            <input type="text" id="codlocal" required asp-for="CodLocal" readonly/>
        </div>

        <div class="form-group">
            <label for="description">Descrição</label>
            <input type="text" id="description" required asp-for="Description" />
        </div>

        <div class="form-group">
            <label for="slc-active">Ativo</label>
            <select id="slc-active" class="form-select" required asp-items="ViewBag.Active" asp-for="Active">
                <option value="" disabled selected hidden="">Selecione</option>
            </select>
        </div>

        <div class="form-group">
            <button type="submit">Salvar</button>
            <button type="submit" id="btn-exc" formaction="@Url.Action("Delete", "Location", new {id = Model.CodLocal })">Excluir</button>
        </div>

    </form>
</div>

@section Scripts {
    <script src="~/js/validate-forms.js"></script>
}
