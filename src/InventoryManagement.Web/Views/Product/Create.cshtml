
@{
    ViewData["Title"] = "Cadastrar Produto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/create-product.css" />
}

<div class="product-create-container">
    <span id="title-register">Cadastrar Produto</span>

    <form class="product-form"> 

        <div class="form-group">
            <label for="description">Descrição</label>
            <input type="text" id="description" />
        </div>

        <div class="form-group">
            <label for="slc-volume">Volume</label>
            <select id="slc-volume" class="form-select">CX</select>
        </div>
            
        <div class="form-group">
            <label for="mark">Marca</label>
            <input type="text" id="mark" />
        </div>

        <div class="form-group">
            <label for="price">Preço</label>
            <input type="number" id="price" />
        </div>

        <div class="form-group">
            <label for="slc-supplier">Fornecedor</label>
            <select id="slc-supplier" class="form-select">Tech Solutions Ltda</select>
        </div>

        <div class="form-group">
            <label for="cost">Custo</label>
            <input type="number" id="cost" />
        </div>

        <div class="form-group">
            <label for="stock">Estoque</label>
            <input type="number" id="stock" />
        </div>

        <div class="form-group">
            <label for="slc-stock-location">Local de Estoque</label>
            <select id="slc-stock-location" class="form-select"> Sem Local</select>
        </div>

        <div class="form-group">
            <label for="stock-min">Estoque Mínimo</label>
            <input type="number" id="stock-min" />
        </div>

        <div class="form-group">
            <label for="stock-max">Estoque Máximo</label>
            <input type="number" id="stock-max" />
        </div>

        <div class="form-group">
            <button type="submit"> Cadastrar</button>
        </div>

    </form>
</div>
